# Firebase — accounts and preference sync.
#
# Copy to `.env.local` and fill in from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
#
# Leave this out entirely and the paper still works: preferences stay on the
# device, and no account UI appears. Nothing here is required to read.
#
# These values are NOT secrets. A Firebase web API key identifies the project;
# it does not grant access to it. Google publishes them in every Firebase web
# app's bundle. What actually protects reader data is firestore.rules — so if
# you change anything, change that carefully.
#
# On Vercel: add each of these under Settings → Environment Variables.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini — the analysis in each story's brief.
#
# Get one, free and without a card, at https://aistudio.google.com/apikey.
# Google's free tier is what makes this affordable: `services/ai/analyse.ts`
# paces itself to the free per-minute limit and stops when the day's allowance
# is gone. Leave it blank and the paper prints with extractive briefs only —
# publishers' own sentences, no generated analysis, nothing broken.
#
# UNLIKE THE FIREBASE VALUES ABOVE, THIS ONE IS A SECRET. It bills a project
# and must never be committed, pasted into a client bundle, or given the
# NEXT_PUBLIC_ prefix — anything so prefixed is compiled into the JavaScript
# every reader downloads. It is read only by a Node script at press time.
#
# On GitHub: Settings → Secrets and variables → Actions → New repository
# secret, named GEMINI_API_KEY. The daily workflow reads it from there.

GEMINI_API_KEY=
